[
  {
    "claim": "No dev-only tooling ships in production HTML",
    "paths": [
      "src/**/*.html"
    ],
    "must_not_match": [
      "agentation",
      "localhost:\\d+"
    ],
    "must_match": []
  },
  {
    "claim": "Only the Spidleweb analytics script is present; legacy Plausible is gone",
    "paths": [
      "src/**/*.html"
    ],
    "must_not_match": [
      "plausible\\.io",
      "googletagmanager\\.com",
      "google-analytics\\.com",
      "fee73a8c-20fc-4378-b6e6-6bafbf242f31"
    ],
    "must_match": [
      "analytics\\.spidleweb\\.net/script\\.js\" data-website-id=\"189ef568-f9bc-4a04-ab30-f10e57cefcdd\""
    ]
  },
  {
    "claim": "Canonical origin is https://ichnos.net/ with no www or http variant",
    "paths": [
      "src/**/*.html",
      "src/sitemap.xml",
      "src/robots.txt"
    ],
    "must_not_match": [
      "http://ichnos\\.net",
      "www\\.ichnos\\.net"
    ],
    "must_match": [
      "https://ichnos\\.net/"
    ]
  },
  {
    "claim": "Publisher is Unwin-Dunraven Literary Ecclesia and submissions go to editors@ichnos.net",
    "paths": [
      "src/index.html"
    ],
    "must_not_match": [
      "Unwin Dunraven Literary",
      "Unwin-Dunraven Press"
    ],
    "must_match": [
      "Unwin-Dunraven Literary Ecclesia",
      "editors@ichnos\\.net"
    ]
  },
  {
    "claim": "ICHNOS has no issues, volumes, schedule, reading periods or submission fees",
    "paths": [
      "src/**/*.html"
    ],
    "must_not_match": [
      "[Ii]ssue \\d+",
      "[Vv]olume \\d+",
      "reading period",
      "submission fee",
      "[Ss]ubmittable"
    ],
    "must_match": []
  },
  {
    "claim": "AI crawlers are disallowed and content signals forbid AI input and training",
    "paths": [
      "src/robots.txt"
    ],
    "must_not_match": [
      "ai-train=yes",
      "ai-input=yes"
    ],
    "must_match": [
      "Content-Signal: search=yes, ai-input=no, ai-train=no",
      "User-agent: GPTBot",
      "User-agent: ClaudeBot",
      "User-agent: Google-Extended",
      "User-agent: CCBot",
      "User-agent: PerplexityBot"
    ]
  }
]
